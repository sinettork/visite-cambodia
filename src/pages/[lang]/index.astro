---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PlaceCard from "../../components/PlaceCard.astro";
import { getPopular, getProvinces, type Lang } from "../../lib/catalog";
import { T } from "../../lib/i18n";

const lang = (Astro.params.lang === "en" ? "en" : "km") as Lang;
const t = T[lang];
const [places, provinces] = await Promise.all([getPopular(6), getProvinces()]);
---
<SiteLayout lang={lang} title={lang === "km" ? "ស្វែងយល់ពីកម្ពុជា" : "Discover Cambodia"} description={t.homeIntro} variant="home">
  <header class="home-hero">
    <img src="/images/angkor-wat-header.jpg" alt="Angkor Wat temple landscape" fetchpriority="high" />
    <div class="home-hero-shade" aria-hidden="true"></div>
    <div class="home-hero-content">
      <h1>{t.homeTitle}</h1>
      <p>{t.homeIntro}</p>
      <div class="home-hero-links">
        <a class="home-primary-link" href={"/" + lang + "/explore"}>{t.homeExplore} <span aria-hidden="true">›</span></a>
        <a class="home-secondary-link" href={"/" + lang + "/itineraries"}>{t.itineraries}</a>
        <a class="home-secondary-link" href={"/" + lang + "/events"}>{t.events}</a>
        <a class="home-secondary-link" href={"/" + lang + "/map"}>{lang === "km" ? "មើលផែនទី" : "Open map"}</a>
      </div>
    </div>
  </header>

  <section class="home-spotlight-section">
    <div class="home-spotlight-grid">
      <a href={"/" + lang + "/itineraries"} class="home-spotlight-card"><span class="spotlight-icon"><i class="fa-solid fa-route" aria-hidden="true"></i></span><div><h3>{t.itineraries}</h3><p>{lang === "km" ? "ដំណើរកម្សាន្តតាមថ្ងៃ សម្រាប់គោលដៅសំខាន់ៗ។" : "Day-by-day plans for key destinations."}</p></div></a>
      <a href={"/" + lang + "/events"} class="home-spotlight-card"><span class="spotlight-icon"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i></span><div><h3>{t.events}</h3><p>{lang === "km" ? "មើលព្រឹត្តិការណ៍ និងពិធីបុណ្យសំខាន់ៗ។" : "Key festivals and seasonal events."}</p></div></a>
      <a href={"/" + lang + "/tools"} class="home-spotlight-card"><span class="spotlight-icon"><i class="fa-solid fa-toolbox" aria-hidden="true"></i></span><div><h3>{t.tools}</h3><p>{lang === "km" ? "ប្តូរប្រាក់ ឃ្លាសន្ទនា និងលេខបន្ទាន់។" : "Currency, Khmer phrases and emergency contacts."}</p></div></a>
    </div>
  </section>

  {places.length > 0 && (
    <section class="home-featured-section" aria-labelledby="home-featured-title">
      <div class="section-head">
        <div><h2 id="home-featured-title">{t.homeFeatured}</h2><p>{t.homeFeaturedIntro}</p></div>
        <a href={"/" + lang + "/explore"}>{t.homeExplore} ›</a>
      </div>
      <div class="review-grid">{places.map((place) => <PlaceCard place={place} lang={lang} />)}</div>
    </section>
  )}

  <section class="home-regions-section" aria-labelledby="home-regions-title">
    <div class="section-head"><h2 id="home-regions-title">{t.homeRegions}</h2><a href={"/" + lang + "/explore#province-list"}>{t.homeAllRegions} ›</a></div>
    <div class="home-region-links">
      {provinces.map((province) => (
        <a href={"/" + lang + "/regions/" + province.slug}>
          {province.banner_image_url ? <img src={province.banner_image_url} alt="" loading="lazy" /> : <span class="review-thumb-empty" aria-hidden="true"></span>}
          <span class="home-region-name">{lang === "km" ? province.name_km : province.name_en}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-editorial-links" aria-label={lang === "km" ? "ព័ត៌មានសម្រាប់ស្វែងយល់បន្ថែម" : "More to explore"}>
    <a class="home-editorial-link home-food-link" href={"/" + lang + "/food"}>
      <img src="/images/food/fish-amok.jpg" alt="Khmer fish amok" loading="lazy" />
      <span><strong>{t.homeFoodTitle}</strong><small>{t.homeFoodIntro}</small><b>{t.cats.food} ›</b></span>
    </a>
    <aside class="home-official-note">
      <h2>{t.homeOfficial}</h2>
      <p>{t.homeOfficialIntro}</p>
      <a href={"/" + lang + "/laws"}>{lang === "km" ? "អានមគ្គុទ្ទេសក៍ច្បាប់ និងប្រភពឯកសារ" : "Read law guides and source notes"} ›</a>
    </aside>
  </section>
</SiteLayout>
