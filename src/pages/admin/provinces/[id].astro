---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAdminContext } from "../../../lib/admin";

const context = await getAdminContext(Astro.request, Astro.cookies);
if (!context.user || !context.admin) return Astro.redirect("/admin/login");

const id = Number(Astro.params.id);
const [{ data: province }, { data: guide }] = await Promise.all([
  context.supabase.from("provinces").select("*").eq("id", id).maybeSingle(),
  context.supabase.from("province_guides").select("*").eq("province_id", id).maybeSingle(),
]);
if (!province) return Astro.redirect("/admin/provinces");

const message = Astro.url.searchParams.get("saved");
const errorCode = Astro.url.searchParams.get("error");
const errorLabels: Record<string, string> = {
  "publish-forbidden": "Your role cannot publish content.",
  "names-required": "Both English and Khmer names are required.",
  "save-failed": "We could not save this province guide. Review the form and try again.",
};
const errorText = errorCode ? errorLabels[errorCode] ?? "We could not save this province guide. Review the form and try again." : "";
---

<AdminLayout email={context.user.email ?? ""} displayName={context.admin.display_name} role={context.admin.role}>
  <section class="admin-page">
    <nav class="admin-breadcrumb" aria-label="Breadcrumb">
      <a class="admin-breadcrumb-link" href="/admin/provinces"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Provinces</a>
      <span class="admin-breadcrumb-sep">/</span><span>{province.name_en}</span>
    </nav>

    <header class="admin-page-heading">
      <div>
        <span class="admin-eyebrow">Province guide</span>
        <h1>{province.name_en}</h1>
        <p>{province.name_km} · Keep the regional hub and its travel guide in one place.</p>
      </div>
      <div class="admin-page-heading-actions">
        <a class="admin-secondary-button" href={"/admin/provinces/" + id + "/preview"} target="_blank" rel="noreferrer"><i class="fa-solid fa-eye" aria-hidden="true"></i> Preview</a>
        <a class="admin-secondary-button" href={"/en/regions/" + province.slug} target="_blank" rel="noreferrer"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Public page</a>
      </div>
    </header>

    {errorText && <div class="admin-alert" role="alert">{errorText}</div>}
    {message && <div class="admin-success" role="status">Province guide saved.</div>}

    <form class="admin-editor-form" method="post" action={"/api/admin/provinces/" + id}>
      <div class="admin-editor-body">
        <section class="admin-panel">
          <div class="admin-field-group">
            <h2 class="admin-field-group-title">Identity</h2>
            <div class="admin-fields-grid">
              <label class="admin-field"><span class="admin-field-label">Name (English)</span><input name="name_en" value={province.name_en} required /></label>
              <label class="admin-field"><span class="admin-field-label">Name (Khmer)</span><input name="name_km" value={province.name_km} required /></label>
              <label class="admin-field admin-field-wide"><span class="admin-field-label">Banner image URL</span><input name="banner_image_url" value={province.banner_image_url ?? ""} placeholder="/images/…" /></label>
            </div>
          </div>

          <div class="admin-field-group">
            <h2 class="admin-field-group-title">Guide content</h2>
            <div class="admin-fields-grid">
              <label class="admin-field admin-field-wide"><span class="admin-field-label">Overview (English)</span><textarea name="overview_en" rows="5">{guide?.overview_en ?? ""}</textarea></label>
              <label class="admin-field admin-field-wide"><span class="admin-field-label">Overview (Khmer)</span><textarea name="overview_km" rows="5">{guide?.overview_km ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">History (English)</span><textarea name="history_en" rows="5">{guide?.history_en ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">History (Khmer)</span><textarea name="history_km" rows="5">{guide?.history_km ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Culture (English)</span><textarea name="culture_en" rows="5">{guide?.culture_en ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Culture (Khmer)</span><textarea name="culture_km" rows="5">{guide?.culture_km ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Travel plan (English)</span><textarea name="travel_en" rows="5">{guide?.travel_en ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Travel plan (Khmer)</span><textarea name="travel_km" rows="5">{guide?.travel_km ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Things to do intro (English)</span><textarea name="attractions_en" rows="4">{guide?.attractions_en ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Things to do intro (Khmer)</span><textarea name="attractions_km" rows="4">{guide?.attractions_km ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Stay guide (English)</span><textarea name="stay_guide_en" rows="4">{guide?.stay_guide_en ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Stay guide (Khmer)</span><textarea name="stay_guide_km" rows="4">{guide?.stay_guide_km ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Food guide (English)</span><textarea name="food_guide_en" rows="4">{guide?.food_guide_en ?? ""}</textarea></label>
              <label class="admin-field"><span class="admin-field-label">Food guide (Khmer)</span><textarea name="food_guide_km" rows="4">{guide?.food_guide_km ?? ""}</textarea></label>
              <label class="admin-field admin-field-wide"><span class="admin-field-label">Source URLs</span><textarea name="source_urls" rows="4" placeholder="One URL per line">{Array.isArray(guide?.source_urls) ? guide.source_urls.join("\n") : ""}</textarea></label>
            </div>
          </div>
        </section>
      </div>

      <div class="admin-save-bar">
        <div class="admin-save-bar-inner">
          <a class="admin-secondary-button" href="/admin/provinces">Back</a>
          <a class="admin-secondary-button" href={"/admin/provinces/" + id + "/preview"} target="_blank" rel="noreferrer"><i class="fa-solid fa-eye" aria-hidden="true"></i> Preview</a>
          <button class="admin-secondary-button" type="submit" name="intent" value="save">Save changes</button>
          <button class="admin-primary-button" type="submit" name="intent" value="save">Save guide</button>
        </div>
      </div>
    </form>
  </section>

</AdminLayout>
