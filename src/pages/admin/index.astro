---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminContext } from "../../lib/admin";

const context = await getAdminContext(Astro.request, Astro.cookies);
if (!context.user || !context.admin) return Astro.redirect("/admin/login");

const [placesResult, provincesResult, draftsResult, missingImageResult, missingLocationResult, activityResult] = await Promise.all([
  context.supabase.from("places").select("id", { count: "exact", head: true }),
  context.supabase.from("provinces").select("id", { count: "exact", head: true }),
  context.supabase.from("places").select("id", { count: "exact", head: true }).eq("publication_status", "draft"),
  context.supabase.from("places").select("id", { count: "exact", head: true }).is("image_url", null),
  context.supabase.from("places").select("id", { count: "exact", head: true }).or("lat.is.null,lng.is.null"),
  context.supabase.from("admin_audit_log").select("id,entity_type,entity_id,action,created_at,admin_user_id").order("created_at", { ascending: false }).limit(8),
]);

const draftCount = draftsResult.count ?? 0;
const cleanupCount = (missingImageResult.count ?? 0) + (missingLocationResult.count ?? 0);
---

<AdminLayout email={context.user.email ?? ""} displayName={context.admin.display_name} role={context.admin.role}>
  <section class="admin-page admin-dashboard-flat">
    <header class="admin-page-heading">
      <div>
        <span class="admin-eyebrow">Workspace</span>
        <h1>Dashboard</h1>
        <p>Manage the public catalogue from one simple workspace.</p>
      </div>
      <a class="admin-page-heading-action" href="/en" target="_blank" rel="noreferrer">
        View public site
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    </header>

    <section class={"admin-dashboard-status-row" + (draftCount > 0 ? " has-drafts" : "")} aria-label="Publishing status">
      <div class="admin-dashboard-status-label">
        <i class={"fa-solid " + (draftCount > 0 ? "fa-circle-exclamation" : "fa-circle-check")} aria-hidden="true"></i>
        <strong>{draftCount > 0 ? draftCount + " draft" + (draftCount === 1 ? "" : "s") + " need review" : "All content is clear for review"}</strong>
      </div>
      <span>{draftCount > 0 ? "Review the record, open its preview, then publish." : "No draft records are waiting for publication."}</span>
      {draftCount > 0 && <a href="/admin/places?status=draft">Review drafts <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}
    </section>

    <section class="admin-dashboard-metrics" aria-label="Catalogue overview">
      <a href="/admin/places"><span>Places</span><strong>{placesResult.count ?? 0}</strong><small>All records</small></a>
      <a href="/admin/provinces"><span>Provinces</span><strong>{provincesResult.count ?? 0}</strong><small>Regional hubs</small></a>
      <a href="/admin/places?status=draft"><span>Drafts</span><strong>{draftCount}</strong><small>Need review</small></a>
      <a href="/admin/places"><span>Cleanup</span><strong>{cleanupCount}</strong><small>{missingImageResult.count ?? 0} images · {missingLocationResult.count ?? 0} coordinates</small></a>
    </section>

    <section class="admin-dashboard-workspace">
      <div class="admin-dashboard-section-head">
        <div>
          <span class="admin-section-kicker">Workflow</span>
          <h2>Common tasks</h2>
        </div>
      </div>

      <nav class="admin-dashboard-task-list" aria-label="Common admin tasks">
        <a href="/admin/places?status=draft"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span><strong>Review drafts</strong><small>Approve, preview and publish pending places</small></span><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
        <a href="/admin/places"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span><strong>Manage places</strong><small>Search, filter and update the public catalogue</small></span><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
        <a href="/admin/provinces"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i><span><strong>Manage provinces</strong><small>Maintain regional destination guides</small></span><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
        <a href="/admin/media"><i class="fa-solid fa-images" aria-hidden="true"></i><span><strong>Review media</strong><small>Check the current production assets</small></span><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
      </nav>
    </section>

    <section class="admin-dashboard-columns">
      <section class="admin-dashboard-workspace">
        <div class="admin-dashboard-section-head">
          <div>
            <span class="admin-section-kicker">Quality</span>
            <h2>Needs attention</h2>
          </div>
        </div>
        <div class="admin-dashboard-issue-list">
          <a href="/admin/places"><span>Missing images</span><strong>{missingImageResult.count ?? 0}</strong><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
          <a href="/admin/places"><span>Missing coordinates</span><strong>{missingLocationResult.count ?? 0}</strong><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
          <a href="/admin/places?status=draft"><span>Drafts to review</span><strong>{draftCount}</strong><i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
        </div>
      </section>

      <section class="admin-dashboard-workspace">
        <div class="admin-dashboard-section-head">
          <div>
            <span class="admin-section-kicker">Activity</span>
            <h2>Recent activity</h2>
          </div>
          <a href="/admin/activity">View all <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>

        {activityResult.data && activityResult.data.length > 0 ? (
          <div class="admin-dashboard-activity-list">
            {activityResult.data.map((item) => (
              <a href={item.entity_type === "place" ? "/admin/places/" + item.entity_id : item.entity_type === "province" ? "/admin/provinces/" + item.entity_id : "/admin/activity"}>
                <span>
                  <strong>{item.action.replaceAll("_", " ")}</strong>
                  <small>{item.entity_type} #{item.entity_id ?? "—"}</small>
                </span>
                <time>{new Date(item.created_at).toLocaleString()}</time>
              </a>
            ))}
          </div>
        ) : (
          <p class="admin-empty-state">No activity recorded yet.</p>
        )}
      </section>
    </section>
  </section>
</AdminLayout>
