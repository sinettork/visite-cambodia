---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminContext } from "../../lib/admin";
const context = await getAdminContext(Astro.request, Astro.cookies);
if (!context.user || !context.admin) return Astro.redirect("/admin/login");
const { data: activity } = await context.supabase.from("admin_audit_log").select("id,admin_user_id,entity_type,entity_id,action,changed_fields,created_at").order("created_at", { ascending: false }).limit(100);
---
<AdminLayout email={context.user.email ?? ""} displayName={context.admin.display_name} role={context.admin.role}>
  <section class="admin-page">
    <header class="admin-page-heading"><h1>Activity log</h1><p>Audited content changes from the new Supabase runtime.</p></header>
    <section class="admin-records-panel">
      <div class="admin-table-wrap">
        <table class="admin-data-table">
          <thead><tr><th>Time</th><th>Entity</th><th>Action</th><th>Changes</th></tr></thead>
          <tbody>
            {(activity ?? []).map((item) => (
              <tr>
                <td>{new Date(item.created_at).toLocaleString()}</td>
                <td>{item.entity_type} #{item.entity_id ?? "—"}</td>
                <td>{item.action}</td>
                <td><code>{JSON.stringify(item.changed_fields)}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {(!activity || activity.length === 0) && <p class="admin-empty-state">No activity recorded yet.</p>}
    </section>
  </section>
</AdminLayout>
