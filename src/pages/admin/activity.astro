---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAdminContext } from "../../lib/admin";

const context = await getAdminContext(Astro.request, Astro.cookies);
if (!context.user || !context.admin) return Astro.redirect("/admin/login");

const actionFilter = ["create", "update", "save_draft", "publish", "pause", "delete"].includes(Astro.url.searchParams.get("action") ?? "")
  ? Astro.url.searchParams.get("action")!
  : "";
let query = context.supabase
  .from("admin_audit_log")
  .select("id,admin_user_id,entity_type,entity_id,action,changed_fields,created_at")
  .order("created_at", { ascending: false })
  .limit(100);
if (actionFilter) query = query.eq("action", actionFilter);
const { data: activity } = await query;

const actionLabel = (action: string) => action.replaceAll("_", " ").replace(/\b\w/g, (char) => char.toUpperCase());
const fieldLabel = (field: string) => field.replace(/^guide$/, "Guide content").replaceAll("_", " ").replace(/\b\w/g, (char) => char.toUpperCase());
const fieldsFor = (value: unknown) => Array.isArray(value) ? value.filter((item): item is string => typeof item === "string").map(fieldLabel) : [];
---

<AdminLayout email={context.user.email ?? ""} displayName={context.admin.display_name} role={context.admin.role}>
  <section class="admin-page">
    <header class="admin-page-heading">
      <div>
        <span class="admin-eyebrow">System</span>
        <h1>Activity log</h1>
        <p>See who changed content, what they changed and when.</p>
      </div>
    </header>

    <section class="admin-records-panel">
      <form class="admin-filter-panel" method="get" action="/admin/activity">
        <label class="admin-filter-item">Action
          <select class="admin-select" name="action" onchange="this.form.submit()">
            <option value="">All actions</option>
            <option value="create" selected={actionFilter === "create"}>Create</option>
            <option value="update" selected={actionFilter === "update"}>Update</option>
            <option value="save_draft" selected={actionFilter === "save_draft"}>Save draft</option>
            <option value="publish" selected={actionFilter === "publish"}>Publish</option>
            <option value="pause" selected={actionFilter === "pause"}>Pause</option>
            <option value="delete" selected={actionFilter === "delete"}>Delete</option>
          </select>
        </label>
        {actionFilter && <a class="admin-clear-filters" href="/admin/activity">Clear</a>}
      </form>

      <div class="admin-table-wrap">
        <table class="admin-data-table">
          <thead><tr><th>Time</th><th>Content</th><th>Action</th><th>Changed</th></tr></thead>
          <tbody>
            {(activity ?? []).map((item) => {
              const href = ["place", "place_guide"].includes(item.entity_type) ? "/admin/places/" + item.entity_id : ["province", "province_guide"].includes(item.entity_type) ? "/admin/provinces/" + item.entity_id : "#";
              const fields = fieldsFor(item.changed_fields);
              return <tr>
                <td><time datetime={item.created_at}>{new Date(item.created_at).toLocaleString()}</time></td>
                <td><a class="admin-table-title" href={href}><strong>{item.entity_type}</strong><small>#{item.entity_id ?? "—"}</small></a></td>
                <td><span class={"admin-status-chip action-" + item.action}>{actionLabel(item.action)}</span></td>
                <td>{fields.length ? <div class="admin-activity-fields">{fields.slice(0, 5).join(" · ")}{fields.length > 5 ? " +" + (fields.length - 5) : ""}</div> : "—"}</td>
              </tr>;
            })}
          </tbody>
        </table>
      </div>
      {(!activity || activity.length === 0) && <p class="admin-empty-state">No activity matches this filter.</p>}
    </section>
  </section>
</AdminLayout>
