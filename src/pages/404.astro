---
const lang = Astro.url.pathname.startsWith("/en") ? "en" : "km";
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>404 | Visit Cambodia</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main style="min-height:100vh;display:grid;place-items:center;padding:32px;font-family:Arial,sans-serif;background:#eaeaea">
      <section style="max-width:560px;text-align:center;background:#fff;padding:48px">
        <p style="margin:0 0 8px;color:#ee7b20;font-weight:700">404</p>
        <h1 style="margin:0 0 12px">{lang === "km" ? "រកមិនឃើញទំព័រ" : "Page not found"}</h1>
        <p style="color:#666">{lang === "km" ? "ទំព័រដែលអ្នកកំពុងស្វែងរកមិនមានទៀតទេ។" : "The page you are looking for does not exist."}</p>
        <a href={"/" + lang} style="display:inline-flex;margin-top:18px;padding:11px 16px;color:#fff;background:#ee7b20;text-decoration:none;font-weight:700">
          {lang === "km" ? "ត្រឡប់ទៅទំព័រដើម" : "Back to Visit Cambodia"}
        </a>
      </section>
    </main>
  </body>
</html>
