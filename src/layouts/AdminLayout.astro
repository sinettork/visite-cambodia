---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "@fontsource/roboto-condensed/400.css";
import "@fontsource/roboto-condensed/500.css";
import "@fontsource/roboto-condensed/600.css";
import "@fontsource/roboto-condensed/700.css";
import "@fortawesome/fontawesome-free/css/fontawesome.min.css";
import "@fortawesome/fontawesome-free/css/solid.min.css";
import "@fortawesome/fontawesome-free/css/regular.min.css";
import "../styles/admin.css";

interface Props {
  email: string;
  displayName?: string;
  role: "super_admin" | "admin" | "editor";
}
const { email, displayName = email.split("@")[0], role } = Astro.props;
const pathname = Astro.url.pathname;
const roleLabel = role === "super_admin" ? "Super admin" : role === "admin" ? "Admin" : "Editor";
const sections = [
  { title: "Workspace", items: [{ href: "/admin", label: "Dashboard", icon: "fa-house" }] },
  { title: "Content", items: [
    { href: "/admin/places", label: "Places", icon: "fa-location-dot" },
    { href: "/admin/provinces", label: "Provinces", icon: "fa-map" },
    { href: "/admin/media", label: "Media library", icon: "fa-images" },
  ]},
  { title: "System", items: [
    { href: "/admin/activity", label: "Activity log", icon: "fa-clock-rotate-left" },
    { href: "/admin/settings", label: "Settings", icon: "fa-gear" },
    ...(role === "super_admin" ? [{ href: "/admin/users", label: "Administrators", icon: "fa-users-gear" }] : []),
  ]},
];
---
<div class="admin-layout">
  <header class="admin-topbar">
    <div class="admin-topbar-left">
      <button class="admin-mobile-menu" type="button" aria-label="Open navigation" aria-controls="admin-sidebar" aria-expanded="false">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <a class="admin-topbar-brand" href="/admin" aria-label="Visit Cambodia Admin dashboard">
        <span class="admin-brand-mark"><i class="fa-solid fa-gem" aria-hidden="true"></i></span>
        <span class="admin-brand-name">Visit Cambodia</span>
      </a>
    </div>
    <div class="admin-topbar-actions">
      <a class="admin-topbar-home" href="/en" target="_blank" rel="noreferrer">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        <span>Public site</span>
      </a>
      <div class="admin-topbar-user" title={email}>
        <div class="admin-topbar-avatar" aria-hidden="true">{email.slice(0,1).toUpperCase()}</div>
        <span class="admin-topbar-user-name">{displayName}</span>
        <span class="admin-topbar-role">{roleLabel}</span>
      </div>
    </div>
  </header>

  <aside id="admin-sidebar" class="admin-sidebar" aria-label="Admin navigation">
    <div class="admin-sidebar-heading"><span class="admin-sidebar-label">ADMIN</span></div>
    <nav class="admin-navigation">
      {sections.map((section) => <div class="admin-navigation-group">
        <p class="admin-navigation-heading">{section.title}</p>
        {section.items.map((item) => {
          const active = item.href === "/admin" ? pathname === item.href : pathname === item.href || pathname.startsWith(item.href + "/");
          return <a class={"admin-navigation-link" + (active ? " is-active" : "")} href={item.href} aria-current={active ? "page" : undefined}>
            <i class={"fa-solid " + item.icon} aria-hidden="true"></i><span>{item.label}</span>
          </a>;
        })}
      </div>)}
    </nav>
    <footer class="admin-sidebar-footer">
      <a href="/en" target="_blank" rel="noreferrer"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i><span>Public site</span></a>
      <form method="post" action="/api/admin/logout"><button type="submit"><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i><span>Sign out</span></button></form>
    </footer>
  </aside>

  <main class="admin-main">
    <div class="admin-main-content"><slot /></div>
    <footer class="admin-footer"><span>© 2026 Visit Cambodia</span></footer>
  </main>
</div>

<script>
  const menu = document.querySelector<HTMLButtonElement>(".admin-mobile-menu");
  const sidebar = document.querySelector<HTMLElement>("#admin-sidebar");
  if (menu && sidebar) {
    const closeSidebar = () => {
      sidebar.classList.remove("is-open");
      menu.setAttribute("aria-expanded", "false");
    };
    const openSidebar = () => {
      sidebar.classList.add("is-open");
      menu.setAttribute("aria-expanded", "true");
    };
    menu.addEventListener("click", () => {
      sidebar.classList.contains("is-open") ? closeSidebar() : openSidebar();
    });
    sidebar.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => link.addEventListener("click", closeSidebar));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeSidebar();
    });
  }
</script>
