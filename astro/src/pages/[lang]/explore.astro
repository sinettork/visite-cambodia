---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { copy, langHref, normalizeLang, type Lang } from "../../lib/content";

export function getStaticPaths() {
  return [{ params: { lang: "en" as Lang } }, { params: { lang: "km" as Lang } }];
}

const lang = normalizeLang(Astro.params.lang);
const t = copy[lang];
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
---

<SiteLayout lang={lang} title={t.destinations}>
  <section class="page-heading">
    <p class="eyebrow">Explore</p>
    <h1>{t.destinations}</h1>
    <p>{lang === "km"
      ? "រកមើលកន្លែងទេសចរណ៍ និងគោលដៅនៅទូទាំងប្រទេសកម្ពុជា។"
      : "Browse destinations and places worth visiting across Cambodia."}</p>
  </section>

  <form class="explore-toolbar" action={langHref(lang, "/explore")} role="search">
    <input name="q" value={query} placeholder={lang === "km" ? "ស្វែងរក..." : "Search..."} />
    <button type="submit">{lang === "km" ? "ស្វែងរក" : "Search"}</button>
  </form>

  <section class="empty-preview">
    <strong>{lang === "km" ? "ដំណាក់កាលទី ១ នៃការផ្ទេរ" : "Migration phase 1"}</strong>
    <p>{lang === "km"
      ? "ទំព័រនេះកំពុងប្រើ Astro shell មុនពេលភ្ជាប់ទៅ Supabase និងផ្ទេរទិន្នន័យពេញលេញ។"
      : "This route is running on the new Astro shell before its full Supabase data layer is connected."}</p>
  </section>
</SiteLayout>
