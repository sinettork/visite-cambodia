---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { copy, langHref, normalizeLang, type Lang } from "../../lib/content";

export function getStaticPaths() {
  return [{ params: { lang: "en" as Lang } }, { params: { lang: "km" as Lang } }];
}

const lang = normalizeLang(Astro.params.lang);
const t = copy[lang];
---

<SiteLayout lang={lang} title={t.heroTitle} description={t.heroIntro}>
  <section class="home-hero">
    <img src="/images/angkor-wat-header.jpg" alt="Angkor Wat temple landscape" fetchpriority="high" />
    <div class="home-hero-shade" aria-hidden="true"></div>
    <div class="home-hero-content">
      <p class="eyebrow">Visit Cambodia</p>
      <h1>{t.heroTitle}</h1>
      <p>{t.heroIntro}</p>
      <a class="home-primary-link" href={langHref(lang, "/explore")}>{t.explore} <span aria-hidden="true">›</span></a>
    </div>
  </section>

  <section class="content-section" aria-labelledby="featured-title">
    <div class="section-head">
      <div>
        <h2 id="featured-title">{t.featured}</h2>
        <p>{lang === "km" ? "ចាប់ផ្តើមពីគោលដៅសំខាន់ៗដែលអ្នកអាចរកមើលបាន។" : "Start with Cambodia's most useful destinations and regional guides."}</p>
      </div>
      <a href={langHref(lang, "/explore")}>{t.explore} ›</a>
    </div>

    <div class="feature-grid">
      {[
        ["Angkor Wat", lang === "km" ? "សៀមរាប" : "Siem Reap", "/images/angkor-wat-header.jpg"],
        ["Phnom Penh", lang === "km" ? "រាជធានីភ្នំពេញ" : "Capital city", "/images/food/kep-crab-market.jpg"],
        ["Kampot", lang === "km" ? "កំពត" : "Riverside & countryside", "/images/food/kampot-pepper-crab.jpg"],
      ].map(([name, meta, image]) => (
        <a class="feature-card" href={langHref(lang, "/explore")}>
          <img src={image} alt="" loading="lazy" decoding="async" />
          <span><strong>{name}</strong><small>{meta}</small></span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
