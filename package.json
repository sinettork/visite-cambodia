{
  "name": "cambodia-tourism",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "clean": "node -e \"for (const p of ['.next','.next-dev']) require('fs').rmSync(p, {recursive: true, force: true})\"",
    "build": "next build",
    "start": "next start",
    "predev": "node scripts/download-fonts.mjs",
    "prebuild": "node scripts/download-fonts.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "leaflet": "^1.9.4",
    "mysql2": "^3.11.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
