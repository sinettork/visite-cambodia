{
  "name": "visite-cambodia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "npm run clean && npm run dev",
    "clean": "node -e \"for (const p of ['dist','.astro']) require('fs').rmSync(p, {recursive: true, force: true})\"",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "predev": "node scripts/download-fonts.mjs",
    "prebuild": "node scripts/download-fonts.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@supabase/supabase-js": "^2.76.1",
    "astro": "^6.0.0",
    "@supabase/ssr": "^0.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
